# ═══════════════════════════════════════════════════════════════════
# CONFIGURAÇÃO DO DYNAMODB COPILOT GAMIFICADO
# ═══════════════════════════════════════════════════════════════════
# Copie para .env e preencha os valores

# Modo de quiz
# closed = apenas múltipla escolha com gabarito determinístico
QUIZ_MODE=closed

# OpenAI API (Opcional)
# Não usada em QUIZ_MODE=closed.
OPENAI_API_KEY=

# CORS
# Em produção interna, troque para o domínio real do frontend.
CORS_ORIGINS=http://localhost:17080,http://127.0.0.1:17080

# DynamoDB Local (Opcional - para queries práticas)
DYNAMODB_ENDPOINT=http://localhost:17000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=fakeAccessKeyId
AWS_SECRET_ACCESS_KEY=fakeSecretAccessKey

# Execução real de código submetido pelo usuário
# Segurança: mantenha false por padrão. Use true apenas em ambiente local controlado.
DYNAMODB_EXECUTION_ENABLED=false

# Chave de Gabaritos (Apenas Instrutor)
# Caminho para secrets/.quiz_key
# Deixar vazio para modo participante (validação via Claude)
QUIZ_KEY_PATH=secrets/.quiz_key

# Modo Debug
DEBUG=false

# Ranking (SQLite local)
RANKING_DB=ranking.db

# OpenAI Model (Opcional - padrão: gpt-4o-mini)
# Opções: gpt-4o-mini (mais rápido/barato) | gpt-4o (mais preciso)
OPENAI_MODEL=gpt-4o-mini

# ═══════════════════════════════════════════════════════════════════
# NOTAS:
# - OPENAI_API_KEY não é necessária em QUIZ_MODE=closed
# - Instrutor: Precisa de QUIZ_KEY_PATH apontando para chave válida
# - NUNCA commitar .env com dados reais
# ═══════════════════════════════════════════════════════════════════

